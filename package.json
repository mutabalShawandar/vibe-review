{
  "name": "vibe-review",
  "displayName": "Vibe Review",
  "description": "Live dependency diagram of your git changes, so you know where to start reviewing AI-generated code.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "mutabalShawandar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mutabalShawandar/vibe-review.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "vibeReview.open",
        "title": "Vibe Review: Open"
      },
      {
        "command": "vibeReview.logChanges",
        "title": "Vibe Review: Log Changes (debug)"
      },
      {
        "command": "vibeReview.analyzeActiveFile",
        "title": "Vibe Review: Analyze Active File (debug)"
      },
      {
        "command": "vibeReview.buildGraph",
        "title": "Vibe Review: Build Graph (debug)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "host": "node scripts/host.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.10.0",
    "jsonc-parser": "3.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  }
}
