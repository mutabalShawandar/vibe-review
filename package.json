{
  "name": "vibe-review",
  "displayName": "Vibe Review",
  "description": "Live dependency diagram of your git changes, so you know where to start reviewing AI-generated code.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mutabalShawandar/vibe-review#readme",
  "bugs": {
    "url": "https://github.com/mutabalShawandar/vibe-review/issues"
  },
  "keywords": [
    "code review",
    "ai",
    "vibe coding",
    "dependency graph",
    "git diff",
    "claude code",
    "copilot"
  ],
  "publisher": "mutabalShawandar",
  "repository": {
    "type": "git",
    "url": "https://github.com/mutabalShawandar/vibe-review.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vibeReview.open",
        "title": "Vibe Review: Open"
      },
      {
        "command": "vibeReview.logChanges",
        "title": "Vibe Review: Log Changes (debug)"
      },
      {
        "command": "vibeReview.analyzeActiveFile",
        "title": "Vibe Review: Analyze Active File (debug)"
      },
      {
        "command": "vibeReview.buildGraph",
        "title": "Vibe Review: Build Graph (debug)"
      }
    ],
    "configuration": {
      "title": "Vibe Review",
      "properties": {
        "vibeReview.debugCommands": {
          "type": "boolean",
          "default": false,
          "description": "Show the debug commands (Log Changes, Analyze Active File, Build Graph) in the Command Palette. Meant for people working on Vibe Review itself."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vibeReview.logChanges",
          "when": "config.vibeReview.debugCommands"
        },
        {
          "command": "vibeReview.analyzeActiveFile",
          "when": "config.vibeReview.debugCommands"
        },
        {
          "command": "vibeReview.buildGraph",
          "when": "config.vibeReview.debugCommands"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "host": "node scripts/host.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "install:vscode": "npm run build && vsce package --no-dependencies && node scripts/install.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.10.0",
    "jsonc-parser": "3.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  }
}
